# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# Only this Telegram user id may use the bot (get yours from @userinfobot).
# The bot handles your drafts and delivers the final article on command, so
# this must be set.
OWNER_TELEGRAM_ID=

# --- Gemini ---
GEMINI_API_KEY=
# Cheap/fast tier for the research tool-calling loop (many round trips).
GEMINI_MODEL=gemini-3.5-flash-lite
# Pro tier for the single final write call -- Flash-class models were
# observed compressing rich research into thin articles; Pro is built for
# thorough synthesis. Priced close to Flash for our token counts.
GEMINI_WRITE_MODEL=gemini-2.5-pro

# --- Write step A/B test (optional) ---
# "gemini" (default) or "deepseek". Research always stays on Gemini either
# way -- this only swaps which model writes the article, so you can compare
# quality/cost directly. DeepSeek is ~3-11x cheaper than gemini-2.5-pro for
# this step; get a key at https://platform.deepseek.com (API keys).
WRITE_PROVIDER=gemini
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro

# --- Research tools ---
# Optional: higher-quality search than the built-in DuckDuckGo fallback.
TAVILY_API_KEY=
# Optional: raises GitHub search rate limit from 10/min to ~30/min (unauthenticated
# search-API limit is lower than the general API limit).
GITHUB_TOKEN=

# --- Medium ---
# No config needed here. Medium removed self-serve API integration tokens,
# so there's no programmatic publish step -- the bot sends you the finished
# article via Telegram to paste into Medium's editor yourself. See README.

# --- Storage ---
DATABASE_PATH=./data/agent.db
